@@ -647,10 +649,19 @@
     let build_dir = env.build_dir.join("gmp-build");
     create_dir_or_panic(&build_dir);
     println!("$ cd {build_dir:?}");
-    let mut conf = String::from("../gmp-src/configure --enable-fat --disable-shared --with-pic");
+    // build_alias (set by build.ps1) names one CPU; the host must match it to
+    // stay a native build. Without it, build portable with runtime dispatch.
+    let native = std::env::var("build_alias").ok();
+    let mut conf = String::from("../gmp-src/configure --disable-shared --with-pic");
+    if native.is_none() {
+        conf.push_str(" --enable-fat");
+    }
     if let Some(cross_target) = env.cross_target.as_ref() {
         conf.push_str(" --host ");
-        conf.push_str(get_actual_cross_target(cross_target));
+        match native {
+            Some(native) => conf.push_str(&native),
+            None => conf.push_str(get_actual_cross_target(cross_target)),
+        }
     }
     configure(&build_dir, &OsString::from(conf));
     make_and_check(env, &build_dir);
